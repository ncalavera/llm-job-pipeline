#!/usr/bin/env bash
# Guardrail: block private data from ever entering this PUBLIC repo.
# Tracked source of truth — install into .git/hooks via scripts/install-hooks.sh
# (or `git config core.hooksPath hooks`). Mirrors the live hook.
# Override (rarely, and only if you are 100% sure): git commit --no-verify
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

blocked=""

# 1) Sensitive PATHS — never commit these.
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    .env|.env.local|.env.*) [ "$f" = ".env.example" ] || blocked+="  $f  (env / secrets)\n" ;;
    config/user_profile.md)   blocked+="  $f  (private candidate profile)\n" ;;
    public/data.js)           blocked+="  $f  (dashboard data — contains PII)\n" ;;
    vacancies/*)              blocked+="  $f  (scraped vacancy data)\n" ;;
    evals/*)                  blocked+="  $f  (personal golden set — labelled vacancies)\n" ;;
    .firecrawl/*)             blocked+="  $f  (scrape cache)\n" ;;
    architecture-notes/*)     blocked+="  $f  (private notes — do not publish)\n" ;;
    .claude-session-acceptance.md) blocked+="  $f  (session file)\n" ;;
    *.db|*.db-wal|*.db-shm|*.sqlite) blocked+="  $f  (local database)\n" ;;
  esac
done <<< "$staged"

# 2) Secret SIGNATURES in staged text content (defence in depth).
secret_re='(sk-[A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'
while IFS= read -r f; do
  [ -z "$f" ] && continue
  [ -f "$f" ] || continue
  if git show ":$f" 2>/dev/null | grep -qIE "$secret_re"; then
    blocked+="  $f  (looks like a hardcoded secret/key)\n"
  fi
done <<< "$staged"

# 3) Private-DATA SIGNATURES — catch a PII leak by CONTENT, not just by name.
# public/data.js is already path-blocked (section 1), but a renamed copy, an
# export, or a debug dump escapes that. Match the serialized triage-review
# fields in their JSON shape: a quoted key, a colon, then a quoted STRING value.
# That opening value-quote is the discriminator: real serialized data pairs the
# key with a quoted string, whereas the source that BUILDS the payload pairs it
# with a variable (r.get(...), no quote), so this never fires on the generator
# or on plain field references. These six keys are triage-only and appear
# nowhere else in the tree.
# Skip .claude/worktrees/: live agent checkouts carry this project's own data
# by design and are never shipped — scanning them makes the guard fire on every
# commit while an agent works (mirrors the PR #43 pytest carve-out).
pii_re='"(cv_notes|first_impression|preparation|skip_reason|research_question|network_contact)"[[:space:]]*:[[:space:]]*"'
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in .claude/worktrees/*) continue ;; esac
  [ -f "$f" ] || continue
  if git show ":$f" 2>/dev/null | grep -qIE "$pii_re"; then
    blocked+="  $f  (contains serialized private triage-review data — PII)\n"
  fi
done <<< "$staged"

if [ -n "$blocked" ]; then
  printf '\n\033[31m✖ COMMIT BLOCKED — private data must not enter this PUBLIC repo:\033[0m\n' >&2
  printf '%b' "$blocked" >&2
  printf '\nUnstage them (git restore --staged <file>) or, if truly intentional, use --no-verify.\n' >&2
  exit 1
fi
exit 0
