# Secrets
.env
.env.local
config/user_profile.md
.claude-session-acceptance.md

# Local data — never commit personal vacancy/company data
vacancies/
.firecrawl/
public/data.js

# Private artifact zone — application artifacts + personal case bank. Default
# location for JOBSEARCH_PRIVATE_DIR (config.PRIVATE_DIR). Only file references
# live in the DB; the CV versions, cover letters, answers and case-bank stories
# themselves never enter git or the public dashboard.
private/

# Personal labelled eval set — never publish
evals/

# Internal dev docs — keep out of the public Pages repo. docs/ also serves the
# GitHub Pages landing, so allow-list only the public assets + the committed
# reference docs back in below.
docs/*
!docs/index.html
!docs/favicon.svg
!docs/assets/
!docs/assets/**
!docs/ARCHITECTURE.md
!docs/job-boards-catalogue.md

# Local illustration packs — personal art for a non-default DASHBOARD_PACK.
# The committed "default" pack lives directly under public/images/. Any pack
# subdirectory (public/images/<pack>/) is local-only and never committed.
.local-illustrations/
public/images/*/

# Vercel CLI deploy denylist (local-only — controls uploads, not committed)
.vercelignore

# Local SQLite database (easy mode) — never commit personal data
data/
*.db
*.db-wal
*.db-shm

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Node
node_modules/
.vercel
.next/

# Local dashboards & reports
reports/
REPORT-*.html
REPORT-*.md
*.local.json

# Private architecture lessons migrated from job-search-2026 (do not publish)
architecture-notes/

# npm lockfile — project installs deps fresh; no lockfile tracked
package-lock.json

# runtime company filter archives
companies/
