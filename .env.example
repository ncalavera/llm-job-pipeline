# Copy to .env and fill in your own values. Never commit the real .env.
# The Python scripts auto-load this file from the repo root (no manual export);
# a variable you already exported in your shell takes priority over it.

# --- Supabase (full/cloud mode — optional) -----------------------------------
# Only needed for the hosted "full" path (multi-device sync, phone digest).
# Leave the SUPABASE_* vars unset to run the local no-account SQLite demo —
# see INSTALL-EASY.md. Full mode also needs the Postgres driver:
# pip install -r requirements.txt
# Get SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY from
# https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection used by Python scripts. Find this in
# Supabase → Project Settings → Database → "Session pooler".
SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Optional: warns if the connected URL doesn't match the expected project ref.
# EXPECTED_SUPABASE_REF=your-project-ref

# --- Anthropic API (NOT required for default /score path) -------------------
# Scoring runs through Claude Code subagents by default (on your subscription),
# not through the API. You only need a key if you reworked the scripts to call
# the Anthropic API directly.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Firecrawl (optional — only used by /fetch with --enrich) ----------------
# Sign up at https://firecrawl.dev to scrape job descriptions and company pages.
FIRECRAWL_API_KEY=fc-...

# --- Dashboard auth (optional, recommended) ----------------------------------
# Vercel middleware.js protects the dashboard with HTTP Basic Auth.
AUTH_USER=admin
AUTH_PASS=change-me

# --- Telegram digest (optional) ----------------------------------------------
# scripts/telegram_digest.py pushes a daily digest of fresh vacancies to a
# Telegram chat with 👍/👎 buttons. Run `poll --loop` as a long-lived daemon to
# capture taps, and `send` from a scheduler / cron once a day.
# Create a bot via @BotFather to get the token; get the chat id from @userinfobot.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
# Optional: file storing the getUpdates offset (default ~/.jobsearch_digest_state.json)
# DIGEST_STATE_FILE=/absolute/path/to/digest_state.json

# --- Profile path override (optional) ----------------------------------------
# By default scripts/prompts.py reads config/user_profile.md, falling back to
# config/user_profile.example.md. Set this to point at any other file.
# USER_PROFILE_PATH=/absolute/path/to/your-profile.md
