[Unit]
Description=Start the job-pipeline run at 22:00 UTC on weeknights (02:00 Tbilisi)

[Timer]
# Weeknights only — Nikita does not triage at the weekend, and a run
# whose results nobody reads still spends the Claude budget.
OnCalendar=Mon..Fri *-*-* 22:00:00 UTC
# A night the server was down runs at the next boot instead of being lost.
Persistent=true

[Install]
WantedBy=timers.target
