[Unit]
Description=Start the job-pipeline run at 22:00 UTC Sun-Thu (02:00 Tbilisi, Mon-Fri mornings)

[Timer]
# Mon-Fri mornings in Tbilisi only (= Sun-Thu in UTC; systemd ranges cannot wrap past Sunday) — Nikita does not
# triage at the weekend, and a run
# whose results nobody reads still spends the Claude budget.
OnCalendar=Mon..Thu,Sun *-*-* 22:00:00 UTC
# A night the server was down runs at the next boot instead of being lost.
Persistent=true

[Install]
WantedBy=timers.target
