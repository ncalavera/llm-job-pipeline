# OFF since 17.10.2026 (DHA-1265): timer disabled; hiring mail comes through Nikita's ChatGPT assistant.
[Unit]
Description=Poll Gmail for recruiter mail every 30 minutes (10 until DHA-994)

[Timer]
OnCalendar=*:0/30
# A missed tick is not worth catching up: the next one lists the same mail.
Persistent=false
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
